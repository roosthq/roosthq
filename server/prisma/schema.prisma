// Roost HQ - data model (see PLANNING.md §10)
// Self-hosted, single-family. family_id is retained on core tables to keep the
// door open to multi-family later; it is not required for single-family use.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  OWNER // instance-level: multi-family creation/management, ghosting - see #18/#19
  FAMILY_MANAGER // full family-management powers (everything OWNER used to mean before the instance-level split)
  ADULT
  KID
}

enum ChoreInstanceStatus {
  OPEN
  PENDING // completed by kid, awaiting adult approval
  APPROVED
  REJECTED
  MISSED // due date passed with no completion and the chore doesn't allow late credit
  SKIPPED // deliberately skipped (chore.allowSkip) - no token, doesn't count as missed
}

enum LedgerType {
  CHORE // awarded on approved chore
  MANUAL // adult manual award/subtract
  PHYSICAL // reconciliation with physical tokens
  REDEEM // spent on a prize
  STREAK_BONUS // awarded for hitting a consecutive on-time completion goal
  AWARD // granted alongside an Award (see AwardGrant)
}

enum NotificationType {
  CHORE_PENDING // kid completed a chore; needs adult approval
  CHORE_APPROVED
  CHORE_REJECTED
  CHORE_MISSED
  CHORE_DUE_SOON
  STREAK_BONUS
  REDEMPTION_REQUESTED
  REDEMPTION_FULFILLED
  REDEMPTION_REJECTED
  PRIZE_SUGGESTED // kid submitted a wishlist item
  CALENDAR_EVENT_ADDED
  CALENDAR_EVENT_REMINDER
  AWARD_GRANTED
  GAME_PRIZE_WON // a reward game (#5) rolled a real Prize, not tokens - adult needs to get it ready
}

enum PrizeType {
  ITEM
  EVENT
}

enum PrizeScope {
  GLOBAL // visible to all kids
  SPECIFIC // visible only to assigned kids
}

enum RedemptionStatus {
  REQUESTED
  APPROVED
  REJECTED
  FULFILLED
}

// ---------- Tenant & people ----------

model Family {
  id                 String   @id @default(cuid())
  name               String
  tokenName          String   @default("Tokens") // what the family calls their reward currency
  tokenIcon          String   @default("coins") // Lucide icon name (lucideData.ts) shown alongside the reward currency - NOT a raw emoji; LucideIcon/AppIcon render a name, and a stray "🪙" here (this field's value before the icon migration) silently renders nothing
  tokenValueUsd      Float    @default(1) // $ value of one token, for auto-suggesting prize costs
  choreWord          String   @default("Chore") // singular; family can rename e.g. "Quest" to de-emphasize chore-as-chore
  // Family-level feature kill-switches (FEATURE_TREE in web/src/api.ts).
  // Stored as the DISABLED list so brand-new features default to ON for
  // every family without a migration backfill.
  disabledFeatures   Json     @default("[]")
  // Which sound plays for which action slot (celebrate.ts on the client) -
  // { [slot: string]: { type: 'builtin', id: string } | { type: 'custom', id: string } }.
  // A slot with no entry falls back to the default built-in chime. Owner/
  // family-manager only to edit; family-wide, no per-person override.
  soundAssignments   Json     @default("{}")
  // #8 - roughly how often (in days) an eligible kid should get a surprise
  // reward game on average; the daily cron rolls 1-in-N odds per kid per
  // day rather than a fixed calendar date, so it stays genuinely surprising.
  surpriseRewardDays Int      @default(30)
  createdAt          DateTime @default(now())

  users           User[]
  locations       Location[]
  calendars       Calendar[]
  localCalendars  LocalCalendar[]
  chores          Chore[]
  prizes          Prize[]
  rules           Rule[]
  awards          Award[]
  displaySettings DisplaySettings?
  displayTokens   DisplayToken[]
  displayConfigs  DisplayConfig[]
  invites         FamilyInvite[]
  mealPlans       MealPlan[]
  eatOutPlaces    EatOutPlace[]
  rewardGames     RewardGame[]
  groceryItems    GroceryItem[]
  countdowns      Countdown[]
  announcements   Announcement[]
  notifications   Notification[]
  customSounds    CustomSound[]
  slotIcons       FamilySlotIcon[]
}

// ---------- Icons ----------
// A "slot" is a named UI position (nav.calendar, kiosk.giveAward,
// notif.AWARD_GRANTED, ... - see ICON_SLOTS in web/src/icons/slots.ts) that
// normally renders its own hardcoded default icon (in Noto). These two
// tables let it render a COMPLETELY DIFFERENT catalog icon instead - not
// just a different art style of the same icon - because that's the actual
// ask: "if I want the calendar icon to be a smiley face, I should be able
// to do that." iconKey is the catalog concept actually shown (validated
// against ICON_KEYS); iconSet is which style it renders in (NOTO | TWEMOJI |
// FLUENT_3D | LUCIDE). Two tiers, resolved family -> app -> the slot's own
// hardcoded default (see IconsService.effective) - AppSlotIcon is the
// instance-owner's platform-wide pick, FamilySlotIcon a per-family override
// on top. slotId/iconKey are free strings validated server-side
// (common/icons.ts mirrors both lists, same pattern as SOUND_SLOTS/
// FEATURE_TREE) rather than enums, so adding a new slot or catalog icon
// later never needs a migration.

model AppSlotIcon {
  slotId    String   @id
  iconKey   String
  iconSet   String
  updatedAt DateTime @updatedAt
}

model FamilySlotIcon {
  id        String   @id @default(cuid())
  familyId  String
  slotId    String
  iconKey   String
  iconSet   String
  updatedAt DateTime @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, slotId])
  @@index([familyId])
}

// A family-uploaded sound (celebrate.ts custom slot assignment). dataUri is
// @db.LongText, not the @db.Text most other data: URI fields in this schema
// use - TEXT's 65KB cap is fine for a small icon photo, but a base64-encoded
// audio clip (up to ~250KB raw per the client-side cap) overflows it.
model CustomSound {
  id          String   @id @default(cuid())
  familyId    String
  label       String
  dataUri     String   @db.LongText
  createdById String
  createdAt   DateTime @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

// In-app notification feed. Same table backs a personal "notifications" view
// (mine, unread-badged) and an adult-only family-wide "activity" view - the
// list() query just widens the where-clause for adults asking for the latter.
model Notification {
  id        String           @id @default(cuid())
  familyId  String
  userId    String // recipient
  type      NotificationType
  title     String
  body      String?          @db.Text
  link      String? // relative app path to deep-link to, e.g. /store
  // The thing this notification is about (award grant, chore instance, prize,
  // event...). Not a real FK - it points at several different tables - but it
  // lets a delete take its notifications with it instead of leaving a feed
  // entry that deep-links to something that no longer exists.
  refId     String?
  createdAt DateTime         @default(now())
  readAt    DateTime?

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId, readAt])
  @@index([refId])
}

// One browser/device's Web Push subscription. A person can have several
// (phone + kiosk browser, etc.) - all get pushed to on a new notification.
model PushSubscription {
  id           String   @id @default(cuid())
  userId       String
  endpoint     String   @db.Text
  endpointHash String   @unique // sha256(endpoint) - endpoint itself is too long to index/unique directly
  p256dh       String   @db.Text
  auth         String   @db.Text
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A named display layout an adult can create (e.g. "Kitchen", "Dad's house").
// Each has its own set of calendars, enabled features, and theme, so different
// kiosks can show different things.
model DisplayConfig {
  id                 String   @id @default(cuid())
  familyId           String
  name               String
  locationId         String? // scopes this kiosk to one location: only people (and
  // calendars they share) assigned to it show up here
  calendarIds        Json
  enabledFeatures    Json
  theme              String   @default("light")
  colorTheme         String   @default("meadow") // which of the 9 hues (see COLOR_THEMES) this kiosk shows when idle
  soundEffects       Boolean  @default(true) // celebration chime on chore complete/approve (kiosk has speakers)
  fontSize           String   @default("md") // sm | md | lg | xl
  onScreenKeyboard   Boolean  @default(false) // pop up a touch keyboard on text fields (Pi kiosks have no hardware one)
  screensaverMinutes Int      @default(0) // show a full-screen clock after this many idle minutes; 0 = never
  weatherLocation    String? // free-text city for the screensaver's weather (Open-Meteo geocoded); unset = no weather shown
  bedtimeStart       String? // "HH:MM" - kiosk dims into bedtime mode inside this window; unset = never
  bedtimeEnd         String? // "HH:MM" - end of the bedtime window (may cross midnight)
  createdById        String
  createdAt          DateTime @default(now())

  family   Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  location Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  tokens   DisplayToken[]

  @@index([familyId])
  @@index([locationId])
}

// One-time invite used to join an existing family with a chosen role. Stored hashed;
// the raw token goes in the invite link the owner shares.
model FamilyInvite {
  id          String    @id @default(cuid())
  familyId    String
  role        Role
  label       String?
  tokenHash   String    @unique
  createdById String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  acceptedAt  DateTime?

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

// Self-service "forgot password" - only reachable for a user with an email
// set (kids typically don't have one; an adult/owner resets those directly).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Owner-minted, revocable, read-only credential for an unattended display device
// (e.g. a Raspberry Pi kiosk). Stored hashed; the raw token is shown once at mint.
model DisplayToken {
  id              String    @id @default(cuid())
  familyId        String
  displayConfigId String? // which display layout this kiosk shows
  tokenHash       String    @unique
  label           String?
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?

  family        Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  displayConfig DisplayConfig? @relation(fields: [displayConfigId], references: [id], onDelete: SetNull)

  @@index([familyId])
}

model User {
  id                  String  @id @default(cuid())
  familyId            String
  role                Role
  displayName         String
  email               String? // required for adults/owner at signup; kids may have none (parent-managed)
  passwordHash        String? @db.Text // local (non-Google) login; null if this account only ever uses Google
  username            String? @unique // local-login id for accounts with no email (mainly kids)
  pinHash             String? // optional per-profile PIN
  // Kid-only master switch: true means nobody can give this kid a kiosk PIN
  // at all (UsersService.setPin refuses), and any existing one was cleared
  // the moment this was turned on. Ignored for adults; see DisplayService.unlock.
  pinDisabled         Boolean @default(false)
  avatar              String? @db.Text // Google photo URLs can exceed the default varchar(191)
  themePref           String  @default("light") // per-user app UI theme: light | dark
  colorTheme          String  @default("meadow") // per-user full page theme: see COLOR_THEMES in users.service.ts
  fontSizePref        String  @default("md") // per-user app text size: sm | md | lg | xl
  soundEffects        Boolean @default(true) // per-user celebration chime on complete/approve (kiosk uses its display setting instead)
  simpleMode          Boolean @default(false) // "My Day" pre-reader view: giant icon tiles instead of dense task lists
  allowanceTokens     Int     @default(0) // weekly automatic token grant (0 = none); paid by the allowance cron when the family feature is on
  rejectionsGiven     Int     @default(0) // lifetime count of chore completions this adult sent back (tracked from 2026-08; adult profile stat)
  birthday            String? // YYYY-MM-DD - age display + automatic birthday countdowns
  // Per-kid ability switches (KID_PERMISSIONS in web/src/api.ts). Stored as
  // the DISABLED list so kids can do everything until an adult turns
  // something off. Ignored for adult roles.
  disabledPermissions Json    @default("[]")
  // #4 - which level this person's own last celebration already covered.
  // Starts at 1 (not 0) so a brand-new account - already "level 1" the
  // instant it exists - doesn't immediately fire a hollow "you leveled up
  // to 1!" the first time anything checks.
  lastCelebratedLevel Int     @default(1)
  // Instance-owner switch: false locks the account out entirely (every API
  // request is refused, existing session cookie or not) without deleting any
  // of their history. See the deactivated-account gate in main.ts.
  active              Boolean @default(true)
  notifyByEmail       Boolean @default(false)
  // When true: chores/awards still work normally (completion, approval,
  // streaks, trophies) but never create a TokenLedger entry for this user,
  // and every token-balance/history UI hides for them - for a family that
  // doesn't want tokens/rewards for some or all members. See
  // UsersService.setTokensDisabled for who can flip this for whom.
  tokensDisabled      Boolean @default(false) // also email notifications (needs `email` set + SMTP configured)

  family                Family               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  locations             UserLocation[]
  googleAccounts        GoogleAccount[]
  calendarShares        CalendarShare[]
  calendarColors        UserCalendarColor[]
  choreAssignments      ChoreAssignee[]
  createdChores         Chore[]              @relation("ChoreCreatedBy")
  ledgerEntries         TokenLedger[]        @relation("LedgerUser")
  ledgerCreated         TokenLedger[]        @relation("LedgerCreatedBy")
  prizeAssigns          PrizeAssignment[]
  redemptions           Redemption[]
  createdPrizes         Prize[]              @relation("PrizeCreatedBy")
  suggestedPrizes       Prize[]              @relation("PrizeSuggestedBy")
  rulesForMe            Rule[]               @relation("RuleTarget")
  rulesCreated          Rule[]               @relation("RuleCreatedBy")
  createdAwards         Award[]              @relation("AwardCreatedBy")
  awardsReceived        AwardGrant[]         @relation("AwardGrantUser")
  rewardGames           RewardGame[]         @relation("RewardGameUser")
  awardsGranted         AwardGrant[]         @relation("AwardGrantedBy")
  approvedChores        ChoreInstance[]      @relation("ChoreInstanceApprovedBy")
  approvedRedemptions   Redemption[]         @relation("RedemptionApprovedBy")
  createdLocalCalendars LocalCalendar[]      @relation("LocalCalendarCreatedBy")
  createdLocalEvents    LocalEvent[]         @relation("LocalEventCreatedBy")
  passwordResetTokens   PasswordResetToken[]
  notifications         Notification[]
  pushSubscriptions     PushSubscription[]

  @@index([familyId])
}

model Location {
  id       String @id @default(cuid())
  familyId String
  name     String
  timezone String @default("UTC") // IANA name, e.g. "America/Denver" - drives due-date math for chores here

  family         Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  users          UserLocation[]
  chores         Chore[]
  displayConfigs DisplayConfig[]
  prizes         Prize[]
  localCalendars LocalCalendar[]

  @@index([familyId])
}

model UserLocation {
  userId     String
  locationId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([userId, locationId])
}

model GoogleAccount {
  id              String   @id @default(cuid())
  userId          String
  googleSub       String   @unique // Google account subject id
  email           String? // captured at connect time, purely for the "which account is this" label in Settings/Profile - never used for lookup
  picture         String?  @db.Text // Google profile photo URL, same reason as email - label only
  tokensEncrypted String   @db.Text // OAuth tokens, encrypted at rest
  needsReconnect  Boolean  @default(false) // refresh token died (invalid_grant) - set on the failing call, cleared on a successful one or a fresh consent
  createdAt       DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendars Calendar[]

  @@index([userId])
}

// ---------- Calendars ----------

model Calendar {
  id               String  @id @default(cuid())
  familyId         String
  googleAccountId  String
  googleCalendarId String // dedup key - one row per unique Google calendar
  name             String
  color            String?

  family        Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  googleAccount GoogleAccount   @relation(fields: [googleAccountId], references: [id], onDelete: Cascade)
  shares        CalendarShare[]

  @@unique([familyId, googleCalendarId]) // no duplicate calendars per family
  @@index([familyId])
}

model CalendarShare {
  calendarId String
  userId     String

  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([calendarId, userId])
}

// A viewer's personal override of how a calendar's color renders for them,
// on top of whatever color the calendar itself carries (Calendar.color or
// LocalCalendar.color, set from Google or by whoever created it). calendarId
// deliberately has no FK - it can point at either table (or the Holidays
// sentinel id), so this stays one generic mechanism instead of two.
model UserCalendarColor {
  id         String   @id @default(cuid())
  userId     String
  calendarId String
  color      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, calendarId])
}

// A calendar that lives entirely in the app - no Google account needed.
// Optionally scoped to a Location (e.g. one calendar per household); a
// family-wide one just leaves locationId null.
model LocalCalendar {
  id          String   @id @default(cuid())
  familyId    String
  locationId  String?
  name        String
  color       String?
  image       String?  @db.Text // data: URI - lets a local calendar show a photo/icon instead of just its color dot
  createdById String
  createdAt   DateTime @default(now())

  family    Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  location  Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdBy User         @relation("LocalCalendarCreatedBy", fields: [createdById], references: [id])
  events    LocalEvent[]

  @@index([familyId])
  @@index([locationId])
}

model LocalEvent {
  id              String    @id @default(cuid())
  localCalendarId String
  title           String
  description     String?   @db.Text
  location        String?
  allDay          Boolean   @default(false)
  startAt         DateTime
  endAt           DateTime
  remindedAt      DateTime? // set once the "starting soon" reminder has fired, so it never double-sends
  createdById     String
  createdAt       DateTime  @default(now())

  calendar  LocalCalendar @relation(fields: [localCalendarId], references: [id], onDelete: Cascade)
  createdBy User          @relation("LocalEventCreatedBy", fields: [createdById], references: [id])

  @@index([localCalendarId])
  @@index([startAt])
}

// ---------- System (instance-wide, not family-scoped) ----------

// One rule that projects into a concrete date every year - not a stored
// date, so "4th Thursday of November" stays correct forever without a
// yearly refresh. Deliberately has no familyId: this is the single global
// "Holidays" calendar every family can add (CalendarsService.events()
// merges its projected occurrences in whenever HOLIDAYS_CALENDAR_ID is
// among the requested calendarIds), editable only by the instance owner
// (see HolidaysService.assertOwner) - same one-of-a-kind Role.OWNER gate
// OwnerService uses for multi-family admin.
model HolidayEvent {
  id         String @id @default(cuid())
  title      String
  ruleType   String // FIXED | NTH_WEEKDAY | EASTER_OFFSET - see HolidaysService for the shape each expects
  month      Int? // 1-12 - FIXED, NTH_WEEKDAY
  day        Int? // 1-31 - FIXED only
  weekday    Int? // 0 (Sun) - 6 (Sat) - NTH_WEEKDAY only
  ordinal    Int? // 1-4, or -1 for "last" - NTH_WEEKDAY only
  offsetDays Int? // days relative to Easter Sunday (0 = Easter itself, -2 = Good Friday) - EASTER_OFFSET only

  createdAt DateTime @default(now())
}

// ---------- Touch display ----------

model DisplaySettings {
  familyId           String   @id
  defaultCalendarIds Json // array of calendar ids shown by default
  enabledFeatures    Json // e.g. ["calendar","chores","tokens","prizes"]
  theme              String   @default("light")
  updatedAt          DateTime @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

// ---------- Chores ----------

model Chore {
  id                 String  @id @default(cuid())
  familyId           String
  title              String
  assignmentType     String  @default("SPECIFIC") // SPECIFIC (assigned people) | ANYONE (claimable)
  dayOfWeek          Int? // legacy single-day anchor - superseded by daysOfWeek, kept so old rows still resolve
  daysOfWeek         Json? // int[] (0=Sun..6=Sat) - which weekdays this recurs on, e.g. Mon-Fri homework
  dueTime            String? // "HH:mm" in the chore's location timezone; null = due end of day
  locationId         String?
  tokenValue         Int     @default(0)
  recurrenceRule     String? // DAILY | WEEKLY | BIWEEKLY | MONTHLY | null = single
  allowLate          Boolean @default(false) // if false (default), missing the due date forfeits the reward
  allowSkip          Boolean @default(false) // assignee can skip an occurrence outright - no token, no checklist required, doesn't break streak
  autoApprove        Boolean @default(false) // completing awards tokens immediately, no adult approval step (trust chores like brushing teeth)
  requireProof       Boolean @default(false) // kid must attach a photo before completing (family photoProof feature)
  firstFinisherBonus Int     @default(0) // extra tokens for whoever completes an ANYONE chore ("chore race")
  streakFreezes      Int     @default(0) // banked freezes (earned at each streak milestone); one is consumed instead of breaking the streak on a miss
  latePenaltyPercent Int     @default(25) // % of reward lost per day late, when allowLate is on
  createdById        String
  currentStreak      Int     @default(0) // consecutive on-time completions; resets on a miss
  bestStreak         Int     @default(0)
  streakGoal         Int? // award a bonus every N in a row; null/0 = disabled
  streakBonusTokens  Int     @default(0)
  useWheelForBonus   Boolean @default(false) // this chore's streak milestone spins the bonus wheel INSTEAD of streakBonusTokens - never both. Only meaningful with the family's bonusWheel feature also on.

  family    Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  location  Location?        @relation(fields: [locationId], references: [id])
  createdBy User             @relation("ChoreCreatedBy", fields: [createdById], references: [id])
  assignees ChoreAssignee[]
  checklist ChoreChecklist[]
  instances ChoreInstance[]

  @@index([familyId])
}

// Which people a SPECIFIC chore is assigned to (one or many).
model ChoreAssignee {
  choreId String
  userId  String

  chore Chore @relation(fields: [choreId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([choreId, userId])
}

model ChoreChecklist {
  id       String  @id @default(cuid())
  choreId  String
  label    String
  sort     Int     @default(0)
  required Boolean @default(true)

  chore  Chore            @relation(fields: [choreId], references: [id], onDelete: Cascade)
  checks ChoreItemCheck[]

  @@index([choreId])
}

model ChoreInstance {
  id              String              @id @default(cuid())
  choreId         String
  dueDate         DateTime
  status          ChoreInstanceStatus @default(OPEN)
  completedAt     DateTime?
  approvedBy      String?
  claimedByUserId String? // who is doing/did this occurrence (for ANYONE, set on claim)
  warnedThreshold Int? // smallest due-soon minutes threshold (120/60/30/15) already notified
  proofImage      String?             @db.Text // photo attached by the kid (data URI) when chore.requireProof

  chore          Chore            @relation(fields: [choreId], references: [id], onDelete: Cascade)
  checks         ChoreItemCheck[]
  approvedByUser User?            @relation("ChoreInstanceApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@unique([choreId, dueDate]) // "next occurrence" spawners are racy (sweep + poller + double-click); this is the backstop
  @@index([choreId])
  @@index([status])
}

model ChoreItemCheck {
  choreInstanceId String
  checklistId     String
  checkedAt       DateTime @default(now())

  instance  ChoreInstance  @relation(fields: [choreInstanceId], references: [id], onDelete: Cascade)
  checklist ChoreChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@id([choreInstanceId, checklistId])
}

// ---------- Tokens ----------
// Balance is DERIVED from the ledger (sum of deltas) - no mutable balance column.

model TokenLedger {
  id          String     @id @default(cuid())
  userId      String
  delta       Int // positive = award, negative = spend/subtract
  reason      String
  type        LedgerType
  refId       String? // chore instance / prize / redemption id
  createdById String
  createdAt   DateTime   @default(now())

  user      User @relation("LedgerUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User @relation("LedgerCreatedBy", fields: [createdById], references: [id])

  @@index([userId])
}

// ---------- Rules ----------

// Plain reference text, not tied to tokens/chores - a shared house-rules
// entry (targetUserId null, visible to every kid) or one adult wrote for a
// specific kid (visible only to that kid, plus every adult).
model Rule {
  id           String   @id @default(cuid())
  familyId     String
  targetUserId String?
  text         String   @db.Text
  createdById  String
  createdAt    DateTime @default(now())

  family     Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  targetUser User?  @relation("RuleTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  createdBy  User   @relation("RuleCreatedBy", fields: [createdById], references: [id])

  @@index([familyId])
}

// ---------- Awards ----------

// A pre-created award "type" (e.g. "Good Sport", "Extra Kind") an adult can
// hand out over and over. Kids only ever see the ones they've actually been
// given - the catalog itself is adults-only, so a surprise stays a surprise.
model Award {
  id                String   @id @default(cuid())
  familyId          String
  name              String
  icon              String?  @db.Text // emoji, or an uploaded icon as a data: URI
  description       String?  @db.Text
  defaultTokenValue Int      @default(0) // pre-fills the grant form; adjustable per grant, doesn't retroactively change past grants
  wheelMin          Int      @default(1) // bonus-wheel range attached to this award (see wheelMax)
  wheelMax          Int      @default(0) // 0 = no wheel; >0 = granting also spins a wheel worth wheelMin..wheelMax extra tokens
  // #5 "Pool" reward type - a third option alongside the flat defaultTokenValue
  // and the plain wheelMin/wheelMax range above. Null poolJson = not using
  // this; when set, granting queues a RewardGame with this weighted pool
  // instead of (not additive with) the flat value or the plain wheel.
  poolJson          Json? // [{kind:'TOKENS',min,max,weight}|{kind:'PRIZE',prizeId,weight}]
  poolGameType      String? // pinned game type, or null = "surprise me" (default)
  poolSlotCount     Int? // cosmetic box/reel count
  createdById       String
  createdAt         DateTime @default(now())

  family    Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy User         @relation("AwardCreatedBy", fields: [createdById], references: [id])
  grants    AwardGrant[]

  @@index([familyId])
}

// One instance of an award being given to a kid - repeatable, so the same
// Award can have many grants for the same user (the count is just how many).
model AwardGrant {
  id          String   @id @default(cuid())
  awardId     String
  userId      String
  grantedById String
  note        String?  @db.Text
  tokenValue  Int      @default(0) // snapshot of what was actually awarded this time - Award.defaultTokenValue can change later without rewriting history
  createdAt   DateTime @default(now())

  award     Award @relation(fields: [awardId], references: [id], onDelete: Cascade)
  user      User  @relation("AwardGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User  @relation("AwardGrantedBy", fields: [grantedById], references: [id])

  @@index([awardId])
  @@index([userId])
}

// ---------- Prizes ----------

model Prize {
  id            String     @id @default(cuid())
  familyId      String
  name          String
  description   String?    @db.Text
  image         String?    @db.Text // URL, or a data: URI for an uploaded image
  // Which region of `image` shows on the small store-card thumbnail, as
  // {x,y,w,h} percentages of the image's own natural size - metadata only,
  // never applied to the image itself. Deliberately non-destructive: image
  // can be a URL with no local pixels to touch, and even for an upload the
  // original stays intact for the full-size detail view. Card rendering
  // (PrizeImage) turns this into a CSS background-position/size instead of
  // ever re-encoding.
  imageCrop     Json?
  url           String?    @db.Text
  realPrice     Decimal?   @db.Decimal(10, 2) // hidden from kid sessions
  tokenCost     Int
  type          PrizeType  @default(ITEM)
  scope         PrizeScope @default(GLOBAL)
  locationId    String? // optional - which house/location this prize belongs to
  repeatable    Boolean    @default(true) // false = one-off; auto-archives once redeemed
  archived      Boolean    @default(false) // out of the active store; can be revived
  // 'STORE' (default, purchasable with tokens, visible to kids) or
  // 'AWARD_ONLY' (hidden from the kid-facing store list entirely - only
  // reachable by being rolled in a #5 reward-game pool; a genuine surprise,
  // never something a kid could just buy or even know exists). Adults still
  // see and can edit AWARD_ONLY prizes in the Store's own management list.
  visibility    String     @default("STORE")
  createdById   String? // who added it - shown to everyone, not just adults
  suggested     Boolean    @default(false) // kid-submitted wishlist item, awaiting adult approval
  suggestedById String?

  family      Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)
  location    Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  creator     User?             @relation("PrizeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  suggestedBy User?             @relation("PrizeSuggestedBy", fields: [suggestedById], references: [id], onDelete: SetNull)
  assignments PrizeAssignment[]
  redemptions Redemption[]
  gameWins    RewardGame[] // #5 - reward-game pool rolls that won this prize

  @@index([familyId])
  @@index([locationId])
}

model PrizeAssignment {
  prizeId String
  userId  String

  prize Prize @relation(fields: [prizeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([prizeId, userId])
}

model Redemption {
  id          String           @id @default(cuid())
  prizeId     String
  userId      String
  status      RedemptionStatus @default(REQUESTED)
  // 'PURCHASE' (default - spent tokens, needs the normal approve/reject flow)
  // or 'GAME' (#5 reward game rolled this Prize - already created FULFILLED,
  // never enters the pending-approval queue, no reject: "you already won it"
  // is a different contract than "you spent tokens on it").
  source      String           @default("PURCHASE")
  requestedAt DateTime         @default(now())
  approvedBy  String?
  usedAt      DateTime? // EVENT prizes only: when the event actually happened,
  // separate from FULFILLED (which just means the adult approved the redemption)

  prize          Prize @relation(fields: [prizeId], references: [id], onDelete: Cascade)
  user           User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedByUser User? @relation("RedemptionApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([prizeId])
  @@index([userId])
}

// ---- Household widgets (meals / grocery / countdowns / announcements) ----
// Simple family-scoped lists surfaced on the kiosk and a Household page.

model MealPlan {
  id            String  @id @default(cuid())
  familyId      String
  locationId    String? // which household's dinner this is; null = family-wide
  date          String // YYYY-MM-DD local date key
  title         String // "Tacos" - ignored (but kept, so switching back off "Out" restores it) once isEatingOut
  notes         String?
  isEatingOut   Boolean @default(false)
  eatOutPlaceId String? // set once a place is chosen/spun; null = "Out" but undecided yet

  family      Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  eatOutPlace EatOutPlace? @relation(fields: [eatOutPlaceId], references: [id], onDelete: SetNull)

  // One dinner per day PER SCOPE (enforced in code - a nullable column can't
  // carry that in a MySQL unique index).
  @@index([familyId, date])
  @@index([eatOutPlaceId])
}

// A household's list of favorite restaurants/places for "Out" nights - adults
// maintain this; the meal-plan spin picks uniformly at random from it. Same
// household-scoping convention as GroceryItem/Countdown/Announcement:
// locationId null = family-wide (visible/spinnable from every house), a real
// id = that house's own list plus whatever's family-wide.
model EatOutPlace {
  id          String   @id @default(cuid())
  familyId    String
  locationId  String?
  name        String
  notes       String?
  createdById String
  createdAt   DateTime @default(now())

  family    Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  mealPlans MealPlan[]

  @@index([familyId])
}

model GroceryItem {
  locationId String? // scoping household; null = family-wide (visible everywhere)
  id         String    @id @default(cuid())
  familyId   String
  label      String
  checked    Boolean   @default(false)
  addedById  String?
  createdAt  DateTime  @default(now())
  checkedAt  DateTime?

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

model Countdown {
  locationId String? // scoping household; null = family-wide (visible everywhere)
  id         String   @id @default(cuid())
  familyId   String
  title      String
  emoji      String   @default("party-popper") // Lucide icon name (lucideData.ts) despite the field name - see Family.tokenIcon's comment above; rendered via LucideIcon in Display.tsx/HouseholdPage.tsx
  date       String // YYYY-MM-DD target day
  createdAt  DateTime @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

model Announcement {
  locationId  String? // scoping household; null = family-wide (visible everywhere)
  id          String    @id @default(cuid())
  familyId    String
  text        String    @db.Text
  createdById String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime? // stops showing after this; null = until deleted

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

// A bonus wheel the recipient still has to spin. Earned by a streak milestone
// or an award grant, but deliberately NOT banked at earn time: an adult
// approving a chore (or handing out an award) shouldn't be the one who spins
// the kid's wheel. The amount is rolled server-side at spin time, inside
// [min,max], then written to the ledger.
// Renamed from WheelSpin (#5 - "the load-bearing feature") but kept mapped to
// the same physical table: a full model rename would drop/recreate on
// `db push` and lose every family's existing spin history, and there's no
// upside to that over @@map. minTokens/maxTokens/amount are the ORIGINAL
// simple range-roll path (still used as-is by the plain streak-bonus wheel -
// chores.service.ts - and a plain award-attached wheel - awards.service.ts);
// poolJson/wonKind/wonPrizeId/slotCount are the NEW pool path (a weighted mix
// of token ranges and real Prizes, only set when an award's "Pool" reward
// type is used). A row uses exactly one path - never both.
model RewardGame {
  id         String    @id @default(cuid())
  familyId   String
  userId     String // who gets to play
  minTokens  Int       @default(1)
  maxTokens  Int       @default(5)
  // Which reveal presentation the client shows - purely visual, the actual
  // roll (server-side, at play time) is identical regardless. Set randomly
  // at creation so a kid gets a mix instead of the same one every time,
  // unless the granter pinned a specific one (see GAME_TYPES in
  // reward-games.service.ts). Field name kept as `style` (pre-dates the
  // gameType/RewardGame rename) rather than churning every existing row.
  style      String    @default("WHEEL")
  // Weighted prize pool: [{kind:'TOKENS',min,max,weight}|{kind:'PRIZE',prizeId,weight}].
  // Null = legacy/simple range-roll path (minTokens..maxTokens only).
  poolJson   Json?
  // Cosmetic - how many boxes/reels/etc the client renders. Null = the game
  // type's own default.
  slotCount  Int?
  // Set at play time (spin()): what the pool actually rolled. Null/unset on
  // the simple range-roll path, where the ledger entry IS the record.
  wonKind    String?
  wonPrizeId String?
  reason     String // e.g. "Bonus wheel: Homework (5 in a row)"
  refId      String? // originating AwardGrant / ChoreInstance id, for reversal
  amount     Int? // rolled at play time; null while unplayed
  spunAt     DateTime?
  createdAt  DateTime  @default(now())

  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user     User   @relation("RewardGameUser", fields: [userId], references: [id], onDelete: Cascade)
  wonPrize Prize? @relation(fields: [wonPrizeId], references: [id], onDelete: SetNull)

  @@index([userId, spunAt])
  @@index([familyId])
  @@map("WheelSpin")
}

// Instance-owner action trail: who deactivated/deleted/created/moved a user,
// created/deleted/renamed a family, or ghosted as someone. No FK to User -
// deliberately: the whole point is the record survives the actor or target
// being deleted, so names are snapshotted as plain strings at write time.
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String? // the owner who did it; null if that owner account is later deleted
  actorName   String // snapshot, since actorId may go stale
  action      String // e.g. "user.deactivate", "family.rename", "ghost.start"
  targetId    String?
  targetLabel String? // snapshot of the target's name at the time
  detail      String?  @db.Text // extra context: old -> new value, family name, etc.
  // Nullable: app-owner actions (family.*, user.*, ghost.*) aren't scoped to
  // a single family the same way, so they leave this unset. Per-family
  // actions (chore.* so far) always set it - required so a lookup by
  // targetId alone (e.g. a deleted chore's history) can still be scoped to
  // the caller's own family instead of trusting an opaque id.
  familyId    String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([targetId, familyId])
}
