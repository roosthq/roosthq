# Copy to .env and fill in. Never commit .env.

# --- Database ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=roosthq
MYSQL_USER=roosthq
MYSQL_PASSWORD=change-me
# Connection string used by Prisma (points at the docker-compose db service)
DATABASE_URL="mysql://roosthq:change-me@db:3306/roosthq"

# --- API ---
PORT=3000
NODE_ENV=development
# Secret for signing app sessions/JWTs. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
# Key for encrypting stored Google OAuth tokens at rest (32-byte hex).
TOKEN_ENCRYPTION_KEY=change-me-32-byte-hex

# Where the frontend runs (used for OAuth redirect back + CORS)
WEB_URL=http://localhost:5173

# --- Google OAuth (register your own; see README) ---
# Scope requested is read/write calendar: .../auth/calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:3000
