# Copy to .env and fill in. Never commit .env.

# --- Database ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=roosthq
MYSQL_USER=roosthq
MYSQL_PASSWORD=change-me
# Connection string used by Prisma (points at the docker-compose db service)
DATABASE_URL="mysql://roosthq:change-me@db:3306/roosthq"

# --- API ---
PORT=3000
NODE_ENV=development
# Secret for signing app sessions/JWTs. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
# Key for encrypting stored Google OAuth tokens at rest (32-byte hex).
TOKEN_ENCRYPTION_KEY=change-me-32-byte-hex

# Where the frontend is reached (used for OAuth redirect back + CORS).
#   dev:  http://localhost:5173
#   prod: https://roost.yourdomain.com   (your Cloudflare Tunnel hostname)
WEB_URL=http://localhost:5173

# --- Google OAuth (register your own; see README) ---
# Scope requested is read/write calendar: .../auth/calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Note the /api prefix. Add BOTH the dev and prod callback URLs as Authorized
# redirect URIs in the Google Cloud console.
#   dev:  http://localhost:3000/api/auth/google/callback
#   prod: https://roost.yourdomain.com/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# --- Frontend ---
# Relative path; the reverse proxy / Vite dev proxy maps /api to the server.
VITE_API_BASE_URL=/api

# --- Cloudflare Tunnel (production only) ---
# Connector token from the Cloudflare Zero Trust dashboard. Leave blank in dev.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Web Push notifications ---
# Generate once: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Email notifications (optional fallback; leave SMTP_HOST blank to disable) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Roost HQ <noreply@example.com>"

# --- DB backups (prod backup sidecar) ---
BACKUP_RETENTION_DAYS=14

# --- Theming ---
# Color theme new members start on (self, kiosk, and everyone until they pick
# their own). One of: meadow, ocean, ember, lavender, slate, rose, sand, mint,
# midnight. Falls back to meadow if blank or not a real theme id.
DEFAULT_COLOR_THEME=meadow

# --- Timezone ---
# Falls back for chores at a location that hasn't set its own timezone (new
# locations start on this too). Any IANA name, e.g. America/Denver,
# America/New_York, Europe/London. Falls back to UTC if blank or not real.
DEFAULT_TIMEZONE=UTC

# --- Feature defaults (Family Settings > Features) ---
# Starting on/off for each top-level module on a brand-new family. Set to
# false/0/off to start disabled; anything else (including unset) starts on.
# Sub-features under a module always start on too - turn individual ones off
# per-family afterward. Owners/family managers can flip any of these later
# regardless of what's set here.
DEFAULT_FEATURE_TOKENS=true
DEFAULT_FEATURE_CHORES=true
DEFAULT_FEATURE_STORE=true
DEFAULT_FEATURE_AWARDS=true
DEFAULT_FEATURE_HOUSEHOLD=true

# --- App updates (owner-only, prod overlay only - see PLANNING.md #15) ---
# A shared secret between `server` and the `updater` service - generate one
# the same way as SESSION_SECRET/TOKEN_ENCRYPTION_KEY:
#   echo "UPDATE_SHARED_SECRET=$(openssl rand -hex 32)"
UPDATE_SHARED_SECRET=

# Absolute path to this checkout ON THE HOST - must match Step 2 of
# DEPLOY.md exactly (default there is /opt/roost-hq). Used as BOTH the bind
# mount source and target for the `updater` container - see that service's
# comment in docker-compose.prod.yml for why they have to match.
HOST_REPO_PATH=/opt/roost-hq

# Absolute path to the VM user's own .ssh directory (holds the key/
# known_hosts that already make `git pull` work today) - e.g.
# /home/roosthq/.ssh. Must be absolute; compose does not expand `~` here.
HOST_SSH_DIR=

# Where `updater` checks for updates FROM. Point this at your own fork if
# you're running one - never editable from inside the app itself (that would
# let a compromised owner session redirect updates at a malicious fork).
UPDATE_REPO_URL=https://github.com/roosthq/roosthq.git
UPDATE_BRANCH=main
